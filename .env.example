# HaloFormCraft Environment Variables Example
# Copy this file to .env and update the values for your local setup.

# ── Backend Configuration ──
# Note: Currently hardcoded to SQLite in development
DATABASE_URL=sqlite:///./forms.db
# Uncomment when migrating to PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/haloform

# ── Security (Pending Implementation) ──
# JWT_SECRET_KEY=your_super_secret_key_here
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=120

# ── Frontend Configuration ──
# API URL injected into React builds
VITE_API_URL=http://localhost:8000/api
